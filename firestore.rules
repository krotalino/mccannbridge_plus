rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return true; // Allow client access in preview environment where anonymous auth is restricted
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ─── Briefs Collection ───
    function isValidBrief(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.status is string && data.status.size() <= 50;
    }

    match /briefs/{briefId} {
      allow read: if true;
      allow create: if isValidId(briefId) && isValidBrief(incoming());
      allow update: if isValidId(briefId) && isValidBrief(incoming());
      allow delete: if isValidId(briefId);
    }

    // ─── Reports Collection ───
    function isValidReport(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.type is string && data.type.size() <= 50
        && data.status is string && data.status.size() <= 50;
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if isValidId(reportId) && isValidReport(incoming());
      allow update: if isValidId(reportId) && isValidReport(incoming());
      allow delete: if isValidId(reportId);
    }

    // ─── Tickets Collection ───
    function isValidTicket(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.status is string && data.status.size() <= 50;
    }

    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if isValidId(ticketId) && isValidTicket(incoming());
      allow update: if isValidId(ticketId) && isValidTicket(incoming());
      allow delete: if isValidId(ticketId);
    }

    // ─── Calendar Posts Collection ───
    function isValidCalendarPost(data) {
      return data.id != null
        && data.canal is string && data.canal.size() <= 50
        && data.status is string && data.status.size() <= 50;
    }

    match /calendarPosts/{postId} {
      allow read: if true;
      allow create: if isValidId(postId) && isValidCalendarPost(incoming());
      allow update: if isValidId(postId) && isValidCalendarPost(incoming());
      allow delete: if isValidId(postId);
    }

    // ─── Publications Pipeline ───
    function isValidPublication(data) {
      return data.id != null
        && data.title is string && data.title.size() <= 500
        && data.statut is string && data.statut.size() <= 50;
    }

    match /publications/{pubId} {
      allow read: if true;
      allow create: if isValidId(pubId) && isValidPublication(incoming());
      allow update: if isValidId(pubId) && isValidPublication(incoming());
      allow delete: if isValidId(pubId);
    }

    // ─── Influencers Collection ───
    function isValidInfluencer(data) {
      return data.id != null;
    }

    match /influencers/{influencerId} {
      allow read, write: if true;
    }

    // ─── Influence Deliverables & Insights ───
    match /influence_deliverables/{delivId} {
      allow read, write: if true;
    }

    match /influence_insights/{insightId} {
      allow read, write: if true;
    }

    // ─── User Profiles ───
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && (request.auth == null || isOwner(userId));
    }

    // ─── Documents Collection ───
    match /documents/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId);
      allow delete: if isValidId(docId);
    }

    // ─── Agents Collection ───
    match /agents/{agentId} {
      allow read: if true;
      allow create, update: if isValidId(agentId);
      allow delete: if isValidId(agentId);
    }

    // ─── Prompts Collection ───
    match /prompts/{promptId} {
      allow read: if true;
      allow create, update: if isValidId(promptId);
      allow delete: if isValidId(promptId);
    }

    // ─── AI Conversations Collection ───
    match /ai_conversations/{convId} {
      allow read: if true;
      allow create, update: if isValidId(convId);
      allow delete: if isValidId(convId);
    }

    // ─── Knowledge Chunks Collection ───
    match /knowledge_chunks/{chunkId} {
      allow read: if true;
      allow create, update: if isValidId(chunkId);
      allow delete: if isValidId(chunkId);
    }

    // ─── Financial Documents Collection ───
    match /financial_documents/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId);
      allow delete: if isValidId(docId);
    }

    // ─── Audit Logs Collection ───
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId);
      allow delete: if isValidId(logId);
    }

    // ─── Notifications ───
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId);
      allow update, delete: if isValidId(notificationId);
    }
  }
}
