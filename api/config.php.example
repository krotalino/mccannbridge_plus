<?php
/**
 * MCCANN BRIDGE - CONFIGURATION BASE DE DONNÉES MYSQL
 * Pour l'exploitation du script SQL `mccannbridge_database.sql` en production
 */

// Définition des paramètres de connexion (A modifier avec vos accès en ligne)
define('DB_HOST', getenv('DB_HOST') ?: 'localhost');
define('DB_NAME', getenv('DB_NAME') ?: 'mccann_bridge');
define('DB_USER', getenv('DB_USER') ?: 'u123456789_mccann');
define('DB_PASS', getenv('DB_PASS') ?: 'VotreMotDePasseSecurise123!');
define('DB_PORT', getenv('DB_PORT') ?: '3306');
define('DB_CHARSET', 'utf8mb4');

try {
    $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";port=" . DB_PORT . ";charset=" . DB_CHARSET;
    $options = [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
        PDO::ATTR_EMULATE_PREPARES   => false,
    ];
    
    $pdo = new PDO($dsn, DB_USER, DB_PASS, $options);
} catch (\PDOException $e) {
    header('Content-Type: application/json', true, 500);
    echo json_encode([
        'error' => true,
        'message' => 'Erreur de connexion à la base de données : ' . $e->getMessage()
    ]);
    exit;
}
